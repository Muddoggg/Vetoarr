# Copy to .env. Do not share this file or expose it publicly.
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL
# Plex sign-in is the only authentication layer. Use Cloudflare orange-cloud proxy,
# TLS, WAF and a per-path rate limit. DO NOT use a Cloudflare Access application.
PORTAL_HOST=cleanup.tb-server.com
# Existing containers MUST be reachable from the Docker network "media".
PLEX_URL=http://192.168.1.26:32400
PLEX_TOKEN=REPLACE_WITH_PLEX_OWNER_TOKEN
MAINTAINERR_URL=http://maintainerr:6246
MOVIE_COLLECTION_ID=1
SHOW_COLLECTION_ID=2
KIDS_MOVIE_COLLECTION_ID=3
ANIME_MOVIE_COLLECTION_ID=4
KIDS_SHOW_COLLECTION_ID=5
ANIME_SHOW_COLLECTION_ID=6
MIN_DELETE_DAYS=1
DATABASE_PATH=/data/requests.sqlite3

# Stable identifier for Plex PIN sign-in (do not change after deployment).
PLEX_SSO_CLIENT_ID=media-approval-portal-unraid-v6
